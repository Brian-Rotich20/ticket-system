NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Neon: copy the connection string (sslmode=require)
DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

BETTER_AUTH_SECRET=<random string, 32+ chars>
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:5173

# Public URL of the web app: tracking and invitation links are built from it (optional)
APP_URL=http://localhost:5173
# Reverse proxies in front of the API, for per-client rate limiting (Render: 1)
TRUST_PROXY_HOPS=0
TRACKING_TOKEN_TTL_DAYS=30
INVITATION_TTL_DAYS=7

MAX_UPLOAD_BYTES=5242880
MAX_ATTACHMENTS_PER_TICKET=10
